# --- Python ---
.venv/
__pycache__/
*.pyc

# --- Node / frontend build artifacts ---
node_modules/
frontend/dist/
frontend/ssr_out/
frontend/ssr_out2/

# --- Patient-derived data (PHI). Scans are memory-only by design; nothing
# derived from a real patient belongs in version history, and all of it is
# regenerable from the source scan. ---
*.stl
*.obj
*.ply
*_output.json
exports/
segmented/

# The encrypted scan cache and the Fernet key that opens it. BOTH, and for the
# same reason: a dental arch mesh identifies a person the way a fingerprint
# does, and a key committed next to its own ciphertext is not encryption. The
# cache is content-addressable and fully regenerable by re-uploading the scan.
storage/
*.scan_key
*.case_key

# --- AI model checkpoints (64MB each, 12 of them) ---
*.h5

# --- Generated handover archive ---
Aligner_App_AI_Export/
Aligner_App_AI_Export.zip
Aligner_App_AI_Export_*.zip

# --- Misc ---
*.log

# --- Playwright ---
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
