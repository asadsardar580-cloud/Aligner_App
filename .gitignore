# --- Python ---
.venv/
.venv_check/
__pycache__/
*.pyc

# --- Node / frontend build artifacts ---
node_modules/
frontend/dist/
frontend/ssr_out/
frontend/ssr_out2/

# --- Patient-derived data (PHI). Scans are memory-only by design; nothing
# derived from a real patient belongs in version history, and all of it is
# regenerable from the source scan. ---
*.stl
*.obj
*.ply
*_output.json
exports/
segmented/

# The encrypted scan cache and the Fernet key that opens it. BOTH, and for the
# same reason: a dental arch mesh identifies a person the way a fingerprint
# does, and a key committed next to its own ciphertext is not encryption. The
# cache is content-addressable and fully regenerable by re-uploading the scan.
storage/
*.scan_key
*.case_key

# --- AI model checkpoints ---
# ToothGroupNetwork ships 12 .h5 files at ~64MB each; CrossTooth ships one
# 27MB .pth. build_ai_export.py already refuses all four extensions on the
# same ground - a model checkpoint is not source, and a binary that large
# in history is paid for on every clone forever.
*.h5
*.pth
*.pt
*.ckpt

# --- Generated handover archive ---
Aligner_App_AI_Export/
Aligner_App_AI_Export.zip
Aligner_App_AI_Export_*.zip

# --- Misc ---
*.log

# --- Telemetry spans ---
# `scratch/` is where telemetry.py's file exporter writes. They are runtime
# artefacts, they rotate to megabytes across a test run, and the PHI filter is
# what keeps them clean - but a span file is still a record of what was done
# on this workstation and does not belong in version history.
scratch/

# --- Playwright ---
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
